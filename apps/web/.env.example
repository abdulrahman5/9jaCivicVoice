# Copy to .env.local for development. Never commit real values.
# Local values come from `pnpm db:civic:start` / `pnpm db:vault:start` output.

# Public origin for links we send (agency links). Optional on Vercel: previews use their own URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Police intake Worker. Optional: when unset, the police option shows "Coming soon".
NEXT_PUBLIC_POLICE_FORM_URL=http://localhost:8787

# Civic database (Supabase)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Police vault (separate Supabase project). Only the admin area reads it.
VAULT_SUPABASE_URL=http://127.0.0.1:55321
VAULT_SUPABASE_SERVICE_ROLE_KEY=
# Private key (base64 PKCS#8 DER) for decrypting officer details; pairs with OFFICER_DETAILS_PUBLIC_KEY in the Worker.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out officer.pem
#   private key, here:      openssl pkcs8 -topk8 -nocrypt -in officer.pem -outform DER | base64 -w0
#   public key, the Worker: openssl pkey -in officer.pem -pubout -outform DER | base64 -w0
# Keep officer.pem offline (paper backup); losing it makes stored officer details unreadable.
OFFICER_DETAILS_PRIVATE_KEY=

# WhatsApp Cloud API (Meta). Use the test number outside production.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

WHATSAPP_GRAPH_VERSION=v23.0

# Secrets: generate with `openssl rand -base64 48` (CONTACT_ENC_KEY: `openssl rand -base64 32`)
CONTACT_HASH_PEPPER=
CONTACT_ENC_KEY=
AGENCY_TOKEN_KEY=
# Bearer token pg_cron uses to call POST /api/jobs/run (store the same value as Supabase Vault secret worker_key)
JOBS_SECRET=

# Bot protection (Cloudflare Turnstile). Optional in development; in production, reports are
# refused without it. Previews use Cloudflare's test keys (see docs/PREVIEW.md).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI and email (used by Edge Function workers; listed here for completeness)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=
